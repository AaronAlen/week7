{
  "info": {
    "name": "StockPilot REST API Collection (42 Endpoints)",
    "description": "Comprehensive Postman API Collection for StockPilot Autonomous Inventory Restock, AI Agents, Procurement & Vendor Intelligence System.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api" },
    { "key": "deploymentUrl", "value": "https://week7-rwe2.onrender.com/api" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "threadId", "value": "restock-prod-2-1787550000000" },
    { "key": "productId", "value": "1" },
    { "key": "refundId", "value": "1" },
    { "key": "evalId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.accessToken) {",
                  "    pm.collectionVariables.set('accessToken', res.accessToken);",
                  "    console.log('JWT accessToken saved successfully');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@stockpilot.io\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/refresh", "host": ["{{baseUrl}}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
    {
      "name": "2. Products",
      "item": [
        {
          "name": "Get Products Catalog",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        },
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Smart RGB Desk Lamp\",\n  \"description\": \"Dimmable LED desk lamp with wireless smartphone charging pad.\",\n  \"sku\": \"SKU-LAMP-010\",\n  \"currentStock\": 8,\n  \"safetyThreshold\": 15,\n  \"targetStock\": 50,\n  \"unitCost\": 35.00,\n  \"supplierName\": \"Lumina Tech Ltd\",\n  \"supplierEmail\": \"orders@luminatech.com\",\n  \"supplierPhone\": \"+15550192834\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/products", "host": ["{{baseUrl}}"], "path": ["products"] }
          }
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitCost\": 38.50,\n  \"safetyThreshold\": 18,\n  \"targetStock\": 55\n}"
            },
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}"] }
          }
        },
        {
          "name": "Upload Product Image",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "image", "type": "file", "src": "" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/products/{{productId}}/image", "host": ["{{baseUrl}}"], "path": ["products", "{{productId}}", "image"] }
          }
        }
      ]
    },
    {
      "name": "3. Inventory & Sales",
      "item": [
        {
          "name": "Record Sale (Atomic Deduction)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2,\n  \"referenceId\": \"POS-SALE-8921\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/inventory/sell", "host": ["{{baseUrl}}"], "path": ["inventory", "sell"] }
          }
        },
        {
          "name": "Manual Stock Adjustment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 1,\n  \"quantity\": 5,\n  \"type\": \"ADJUSTMENT\",\n  \"notes\": \"Annual physical warehouse audit correction\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/inventory/adjust", "host": ["{{baseUrl}}"], "path": ["inventory", "adjust"] }
          }
        },
        {
          "name": "Get Inventory Transactions Audit Log",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/inventory/transactions?limit=50", "host": ["{{baseUrl}}"], "path": ["inventory", "transactions"], "query": [{ "key": "limit", "value": "50" }] }
          }
        }
      ]
    },

          "name": "Retry Restock Evaluation",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/restocks/1/retry", "host": ["{{baseUrl}}"], "path": ["restocks", "1", "retry"] }
          }

    {
      "name": "10. Customer Refunds AI Agent",
      "item": [
        {
          "name": "Process Refund Claim (AI Evaluation)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Alice Johnson\",\n  \"customerEmail\": \"alice@example.com\",\n  \"productId\": 1,\n  \"amount\": 75.00,\n  \"daysSincePurchase\": 5,\n  \"reason\": \"Wrong model ordered - unopened in box\",\n  \"customerMessage\": \"The box is completely unopened and in brand new condition, but I ordered the wrong model.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/refunds/process", "host": ["{{baseUrl}}"], "path": ["refunds", "process"] }
          }
        },

        {
          "name": "Receive Stock Delivery",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/restocks/1/receive", "host": ["{{baseUrl}}"], "path": ["restocks", "1", "receive"] }
          }
        }
      ]
    },
    {
      "name": "5. Approvals Queue (HITL)",
      "item": [
        {
          "name": "Get Pending Approvals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/approvals?status=PENDING", "host": ["{{baseUrl}}"], "path": ["approvals"], "query": [{ "key": "status", "value": "PENDING" }] }
          }
        },
        {
          "name": "Submit Approval Decision (Approve/Reject)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"threadId\": \"{{threadId}}\",\n  \"approved\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/approvals/approve", "host": ["{{baseUrl}}"], "path": ["approvals", "approve"] }
          }
        },
        {
          "name": "Approve Restock (Alias Route)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"threadId\": \"{{threadId}}\",\n  \"approved\": true\n}"
            },
            "url": { "raw": "{{baseUrl}}/approve-restock", "host": ["{{baseUrl}}"], "path": ["approve-restock"] }
          }
        },
        {
          "name": "Cancel Approval Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/approvals/1", "host": ["{{baseUrl}}"], "path": ["approvals", "1"] }
          }
        }
      ]
    },

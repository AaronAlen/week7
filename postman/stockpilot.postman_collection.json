            "body": {
              "mode": "raw",
              "raw": "{\n  \"toEmail\": \"alice@example.com\",\n  \"subject\": \"Update on your StockPilot Refund Request\",\n  \"emailBody\": \"Your refund has been approved successfully.\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/refunds/send-email", "host": ["{{baseUrl}}"], "path": ["refunds", "send-email"] }
          }
        }
